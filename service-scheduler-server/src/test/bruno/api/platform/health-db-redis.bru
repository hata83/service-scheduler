meta {
  name: health-db-redis
  type: http
  seq: 1
}

get {
  url: {{BASE_URL}}/actuator/health
  body: none
  auth: none
}

test "health responds 200 UP" {
  expect(res.status).to.equal(200);
  expect(res.body.status).to.equal("UP");
}

test "health proves db and redis connectivity" {
  expect(res.body.components.db.status).to.equal("UP");
  expect(res.body.components.redis.status).to.equal("UP");
}
