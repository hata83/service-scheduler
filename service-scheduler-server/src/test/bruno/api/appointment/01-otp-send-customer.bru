meta {
  name: 01-otp-send-customer
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/api/v1/auth/otp/send
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Idempotency-Key: otp-send-LOGIN-appt-84900000004
  X-Forwarded-For: 203.0.113.88
}

body:json {
  {
    "phone": "+84900000004",
    "type": "LOGIN"
  }
}

script:post-response {
  bru.setEnvVar("LOGIN_CODE_CUSTOMER_APPT", res.getBody().otpCode);
}

tests {
  test("send LOGIN code responds 202", function() {
    expect(res.getStatus()).to.equal(202);
  });
}
