meta {
  name: appointment-get-by-id
  type: http
  seq: 17
}

get {
  url: {{BASE_URL}}/api/v1/appointments/{{CREATED_APPOINTMENT_ID}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Cookie: jwt={{JWT_CUSTOMER}}
}

tests {
  test("appointment get by id responds 200 with appointment details", function() {
    expect(res.getStatus()).to.equal(200);
    const expectedId = bru.getEnvVar('CREATED_APPOINTMENT_ID');
    if (expectedId) {
      expect(res.getBody().id).to.equal(expectedId);
    }
    expect(res.getBody().dealershipId).to.equal("00000000-0000-0000-0000-000000000001");
    expect(res.getBody().serviceJobs).to.be.an('array');
  });
}
