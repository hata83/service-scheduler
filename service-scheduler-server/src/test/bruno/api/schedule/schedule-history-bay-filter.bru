meta {
  name: schedule-history-bay-filter
  type: http
  seq: 6
}

get {
  url: {{BASE_URL}}/api/v1/schedule/history?bayId=33333333-0000-0000-0000-000000000002
  body: none
  auth: none
}

headers {
  Accept: application/json
  Cookie: jwt={{JWT_MANAGER}}
}

tests {
  test("manager history with a bay filter responds 200 with an array", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an('array');
    res.getBody().forEach(function (item) {
      expect(item.id).to.be.a('string');
    });
  });
}
