meta {
  name: notifications-stream
  type: http
  seq: 3
}

get {
  url: {{BASE_URL}}/api/v1/notifications/stream?closeAfterInitial=true
  body: none
  auth: none
}

headers {
  Accept: text/event-stream
  Cookie: jwt={{JWT_CUSTOMER}}
}

tests {
  test("notifications stream responds 200 with text/event-stream", function() {
    expect(res.getStatus()).to.equal(200);
    const contentType = res.getHeader('content-type') || '';
    expect(contentType).to.include("text/event-stream");
  });
}
