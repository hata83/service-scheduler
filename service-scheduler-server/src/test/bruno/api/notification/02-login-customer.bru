meta {
  name: 02-login-customer
  type: http
  seq: 2
}

post {
  url: {{BASE_URL}}/api/v1/auth/otp/verify
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Idempotency-Key: otp-verify-notif-84900000004
  X-Forwarded-For: 203.0.113.89
}

body:json {
  {
    "phone": "+84900000004",
    "code": "{{LOGIN_CODE_CUSTOMER_NOTIF}}"
  }
}

script:post-response {
  const headers = res.getHeaders() || {};
  const key = Object.keys(headers).find((k) => k.toLowerCase() === 'set-cookie');
  const raw = key ? headers[key] : '';
  const first = Array.isArray(raw) ? raw[0] : raw;
  const cookie = (first || '').split(';')[0].replace(/^jwt=/, '');
  bru.setEnvVar('JWT_CUSTOMER', cookie);
}

tests {
  test("customer login responds 200 and captures cookie", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().role).to.equal("CUSTOMER");
  });
}
