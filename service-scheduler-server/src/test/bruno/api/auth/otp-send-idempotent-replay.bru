meta {
  name: otp-send-idempotent-replay
  type: http
  seq: 19
}

post {
  url: {{BASE_URL}}/api/v1/auth/otp/send
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Idempotency-Key: otp-send-LOGIN-84900000004
  X-Forwarded-For: 203.0.113.19
}

body:json {
  {
    "phone": "+84900000004",
    "type": "LOGIN"
  }
}

tests {
  test("replayed send responds 202 with the cached code", function() {
    expect(res.getStatus()).to.equal(202);
    expect(res.getBody().otpCode).to.equal(bru.getEnvVar("LOGIN_CODE_CUSTOMER"));
  });
  
}