meta {
  name: login-customer
  type: http
  seq: 26
}

post {
  url: {{BASE_URL}}/api/v1/auth/otp/verify
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Idempotency-Key: otp-verify-84900000004
  X-Forwarded-For: 203.0.113.23
}

body:json {
  {
    "phone": "+84900000004",
    "code": "{{LOGIN_CODE_CUSTOMER}}"
  }
}

script:post-response {
  const headers = res.getHeaders() || {};
  const key = Object.keys(headers).find((k) => k.toLowerCase() === 'set-cookie');
  const raw = key ? headers[key] : '';
  const first = Array.isArray(raw) ? raw[0] : raw;
  const cookie = (first || '').split(';')[0].replace(/^jwt=/, '');
  bru.setEnvVar('JWT_CUSTOMER', cookie);
}

tests {
  test("customer login responds 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  

  test("customer login carries the CUSTOMER role", function() {
    expect(res.getBody().role).to.equal("CUSTOMER");
    expect(res.getBody().phone).to.equal("+84900000004");
    expect(res.getBody().dealershipId).to.be.null;
  });
  

  test("customer login sets the httpOnly session cookie", function() {
    const headers = res.getHeaders() || {};
    const key = Object.keys(headers).find((k) => k.toLowerCase() === 'set-cookie');
    expect(key).to.not.be.undefined;
    const raw = headers[key];
    const first = Array.isArray(raw) ? raw[0] : raw;
    expect(first).to.include("HttpOnly");
  });
  
}