meta {
  name: verify-missing-idempotency-key
  type: http
  seq: 30
}

post {
  url: {{BASE_URL}}/api/v1/auth/otp/verify
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Forwarded-For: 203.0.113.30
}

body:json {
  {
    "phone": "+84900000004",
    "code": "123456"
  }
}

tests {
  test("missing idempotency key responds 400", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader('content-type')).to.include("application/problem+json");
  });
  
}