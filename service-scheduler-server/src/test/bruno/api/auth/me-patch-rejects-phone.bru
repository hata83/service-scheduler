meta {
  name: me-patch-rejects-phone
  type: http
  seq: 35
}

patch {
  url: {{BASE_URL}}/api/v1/auth/me
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: jwt={{JWT_CUSTOMER}}
  X-Idempotency-Key: patch-me-customer-phone
}

body:json {
  {
    "phone": "+84900000888"
  }
}

tests {
  test("patch with a phone field responds 400", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader('content-type')).to.include("application/problem+json");
  });
  
}