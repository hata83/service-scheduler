meta {
  name: otp-send-login-manager
  type: http
  seq: 11
}

post {
  url: {{BASE_URL}}/api/v1/auth/otp/send
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Idempotency-Key: otp-send-LOGIN-84900000002
  X-Forwarded-For: 203.0.113.11
}

body:json {
  {
    "phone": "+84900000002",
    "type": "LOGIN"
  }
}

script:post-response {
  bru.setEnvVar("LOGIN_CODE_MANAGER", res.getBody().otpCode);
}

tests {
  test("send LOGIN code for the manager responds 202", function() {
    expect(res.getStatus()).to.equal(202);
    expect(res.getBody().otpCode).to.match(/^[0-9]{6}$/);
  });
  
}