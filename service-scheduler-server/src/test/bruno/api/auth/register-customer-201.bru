meta {
  name: register-customer-201
  type: http
  seq: 45
}

post {
  url: {{BASE_URL}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Idempotency-Key: register-84900000999
  X-Forwarded-For: 203.0.113.45
}

body:json {
  {
    "phone": "+84900000999",
    "firstName": "Tai",
    "lastName": "Le",
    "code": "{{REGISTER_CODE_NEW}}"
  }
}

script:post-response {
  const headers = res.getHeaders() || {};
  const key = Object.keys(headers).find((k) => k.toLowerCase() === 'set-cookie');
  const raw = key ? headers[key] : '';
  const first = Array.isArray(raw) ? raw[0] : raw;
  bru.setEnvVar('JWT_NEW_CUSTOMER', (first || '').split(';')[0].replace(/^jwt=/, ''));
}

tests {
  test("registration responds 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  

  test("registration creates a CUSTOMER and returns the id", function() {
    expect(res.getBody().role).to.equal("CUSTOMER");
    expect(res.getBody().phone).to.equal("+84900000999");
    expect(res.getBody().id).to.match(/^[0-9a-f-]{36}$/);
  });
  

  test("registration sets the session cookie", function() {
    const headers = res.getHeaders() || {};
    const key = Object.keys(headers).find((k) => k.toLowerCase() === 'set-cookie');
    expect(key).to.not.be.undefined;
    const raw = headers[key];
    const first = Array.isArray(raw) ? raw[0] : raw;
    expect(first).to.include("HttpOnly");
  });
  
}