meta {
  name: me-patch-missing-idempotency-key
  type: http
  seq: 40
}

patch {
  url: {{BASE_URL}}/api/v1/auth/me
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: jwt={{JWT_CUSTOMER}}
}

body:json {
  {
    "email": "no.key@example.com"
  }
}

tests {
  test("patch without an idempotency key responds 400", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader('content-type')).to.include("application/problem+json");
  });
  
}