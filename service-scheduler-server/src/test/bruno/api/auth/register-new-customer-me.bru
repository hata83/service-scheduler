meta {
  name: register-new-customer-me
  type: http
  seq: 51
}

get {
  url: {{BASE_URL}}/api/v1/auth/me
  body: none
  auth: none
}

headers {
  Cookie: jwt={{JWT_NEW_CUSTOMER}}
}

tests {
  test("the new customer is logged in after registration", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().role).to.equal("CUSTOMER");
    expect(res.getBody().phone).to.equal("+84900000999");
  });
  

  test("the new customer carries the registration names", function() {
    expect(res.getBody().firstName).to.equal("Tai");
    expect(res.getBody().lastName).to.equal("Le");
  });
  
}