meta {
  name: login-technician
  type: http
  seq: 25
}

post {
  url: {{BASE_URL}}/api/v1/auth/otp/verify
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Idempotency-Key: otp-verify-84900000003
  X-Forwarded-For: 203.0.113.25
}

body:json {
  {
    "phone": "+84900000003",
    "code": "{{LOGIN_CODE_TECHNICIAN}}"
  }
}

tests {
  test("technician login responds 200 with the TECHNICIAN role", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().role).to.equal("TECHNICIAN");
  });
  
}