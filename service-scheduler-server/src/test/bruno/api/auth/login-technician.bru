meta {
  name: login-technician
  type: http
  seq: 28
}

post {
  url: {{BASE_URL}}/api/v1/auth/otp/verify
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Idempotency-Key: otp-verify-84900000003
  X-Forwarded-For: 203.0.113.25
}

body:json {
  {
    "phone": "+84900000003",
    "code": "{{LOGIN_CODE_TECHNICIAN}}"
  }
}

script:post-response {
  const headers = res.getHeaders() || {};
  const key = Object.keys(headers).find((k) => k.toLowerCase() === 'set-cookie');
  const raw = key ? headers[key] : '';
  const first = Array.isArray(raw) ? raw[0] : raw;
  bru.setEnvVar('JWT_TECHNICIAN', (first || '').split(';')[0].replace(/^jwt=/, ''));
}

tests {
  test("technician login responds 200 with the TECHNICIAN role and bound dealership", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().role).to.equal("TECHNICIAN");
    expect(res.getBody().dealershipId).to.equal("00000000-0000-0000-0000-000000000001");
  });
  
}