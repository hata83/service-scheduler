meta {
  name: me-patch-rejects-staff-names
  type: http
  seq: 36
}

patch {
  url: {{BASE_URL}}/api/v1/auth/me
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: jwt={{JWT_ADMIN}}
  X-Idempotency-Key: patch-me-admin-names
}

body:json {
  {
    "firstName": "Not",
    "lastName": "Editable"
  }
}

tests {
  test("staff role patch with names responds 400", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader('content-type')).to.include("application/problem+json");
  });
  
}