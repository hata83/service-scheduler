meta {
  name: verify-expired-code
  type: http
  seq: 55
}

post {
  url: {{BASE_URL}}/api/v1/auth/otp/send
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Idempotency-Key: otp-send-LOGIN-84900000988
  X-Forwarded-For: 203.0.113.52
}

body:json {
  {
    "phone": "+84900000988",
    "type": "LOGIN"
  }
}

script:post-response {
  bru.setEnvVar("EXPIRED_CODE", res.getBody().otpCode);
}

tests {
  test("send a code that expires responds 202", function() {
    expect(res.getStatus()).to.equal(202);
  });
  
}