meta {
  name: login-admin
  type: http
  seq: 26
}

post {
  url: {{BASE_URL}}/api/v1/auth/otp/verify
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Idempotency-Key: otp-verify-84900000001
  X-Forwarded-For: 203.0.113.26
}

body:json {
  {
    "phone": "+84900000001",
    "code": "{{LOGIN_CODE_ADMIN}}"
  }
}

script:post-response {
  const headers = res.getHeaders() || {};
  const key = Object.keys(headers).find((k) => k.toLowerCase() === 'set-cookie');
  const raw = key ? headers[key] : '';
  const first = Array.isArray(raw) ? raw[0] : raw;
  bru.setEnvVar('JWT_ADMIN', (first || '').split(';')[0].replace(/^jwt=/, ''));
}

tests {
  test("admin login responds 200 with the ADMIN role", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().role).to.equal("ADMIN");
  });
  
}