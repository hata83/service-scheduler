meta {
  name: login-manager
  type: http
  seq: 27
}

post {
  url: {{BASE_URL}}/api/v1/auth/otp/verify
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Idempotency-Key: otp-verify-84900000002
  X-Forwarded-For: 203.0.113.24
}

body:json {
  {
    "phone": "+84900000002",
    "code": "{{LOGIN_CODE_MANAGER}}"
  }
}

script:post-response {
  const headers = res.getHeaders() || {};
  const key = Object.keys(headers).find((k) => k.toLowerCase() === 'set-cookie');
  const raw = key ? headers[key] : '';
  const first = Array.isArray(raw) ? raw[0] : raw;
  bru.setEnvVar('JWT_MANAGER', (first || '').split(';')[0].replace(/^jwt=/, ''));
}

tests {
  test("manager login responds 200 with the MANAGER role and local dealership", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().role).to.equal("MANAGER");
    expect(res.getBody().dealershipId).to.equal("00000000-0000-0000-0000-000000000001");
  });
  
}