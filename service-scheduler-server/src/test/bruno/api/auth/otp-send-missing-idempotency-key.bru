}

post {
  url: {{BASE_URL}}/api/v1/auth/otp/send
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Forwarded-For: 203.0.113.18
}

body:json {
  {
    "phone": "+84900000004",
    "type": "LOGIN"
