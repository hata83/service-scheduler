meta {
  name: verify-rejects-register-purpose
  type: http
  seq: 28
}

post {
  url: {{BASE_URL}}/api/v1/auth/otp/verify
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Idempotency-Key: otp-verify-register-purpose-84900000004
  X-Forwarded-For: 203.0.113.28
}

body:json {
  {
    "phone": "+84900000004",
    "code": "{{REGISTER_CODE_CUSTOMER_PHONE}}"
  }
}

tests {
  test("register-purpose code at login responds 401", function() {
    expect(res.getStatus()).to.equal(401);
    expect(res.getHeader('content-type')).to.include("application/problem+json");
  });
  
}