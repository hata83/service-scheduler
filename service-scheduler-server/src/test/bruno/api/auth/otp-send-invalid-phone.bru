meta {
  name: otp-send-invalid-phone
  type: http
  seq: 17
}

post {
  url: {{BASE_URL}}/api/v1/auth/otp/send
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Idempotency-Key: otp-send-LOGIN-bad-phone
  X-Forwarded-For: 203.0.113.17
}

body:json {
  {
    "phone": "8490000000",
    "type": "LOGIN"
  }
}

tests {
  test("invalid phone responds 400", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader('content-type')).to.include("application/problem+json");
  });
  
}