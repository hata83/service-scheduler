meta {
  name: verify-expired-code-rejected
  type: http
  seq: 53
}

post {
  url: {{BASE_URL}}/api/v1/auth/otp/verify
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Idempotency-Key: otp-verify-expired-84900000988
  X-Forwarded-For: 203.0.113.53
}

body:json {
  {
    "phone": "+84900000988",
    "code": "{{EXPIRED_CODE}}"
  }
}

script:pre-request {
  // The test profile expires the code after 15 seconds
  await new Promise((resolve) => setTimeout(resolve, 17000));
}

tests {
  test("an expired code responds 401", function() {
    expect(res.getStatus()).to.equal(401);
    expect(res.getHeader('content-type')).to.include("application/problem+json");
  });
  
}