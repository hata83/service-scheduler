meta {
  name: verify-idempotent-replay
  type: http
  seq: 31
}

post {
  url: {{BASE_URL}}/api/v1/auth/otp/verify
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Idempotency-Key: otp-verify-84900000004
  X-Forwarded-For: 203.0.113.31
}

body:json {
  {
    "phone": "+84900000004",
    "code": "{{LOGIN_CODE_CUSTOMER}}"
  }
}

tests {
  test("replayed verify responds 200 with the cached body", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().role).to.equal("CUSTOMER");
  });
  
}