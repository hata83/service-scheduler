  "cards": [
    {
      "dot": "cyan",
      "title": "Multi-value constraints",
      "items": [
        "service_types.allowed_bay_types is an array, so one service type fits several bay types",
        "workshop_bays.bay_types is an array, so a bay is multi-purpose",
        "technician_skills gives one technician many skills with a level per skill"
      ]
    },
    {
      "dot": "amber",
      "title": "Vehicle catalog & pricing matrix",
      "items": [
        "vehicles table stores VIN, brand, model, year per dealership",
        "service_type_costs maps (service_type_id, vehicle_id) to catalog price",
        "estimate_cost rolls up to appointments and is negotiated before check-in"
      ]
    },
    {
      "dot": "emerald",
      "title": "Booking safety & concurrency",
      "items": [
        "EXCLUDE USING gist on service_jobs prevents bay overlap",
        "EXCLUDE on appointments prevents duplicate vehicle booking",
        "EXCLUDE on job_technician_assignments prevents technician overlap",
        "idempotency_key is unique, so retried requests never double-book"
      ]
    }
  ]
