        "id": "booking",
        "label": "Booking core",
        "focus": [
          "users",
          "customers",
          "appointments",
          "service_jobs",
          "job_assignments"
        ],
        "note": "appointments is the hub. It holds the appointment state machine and the bay window."
      },
      {
        "id": "capacity",
        "label": "Capacity and constraints",
        "focus": [
          "service_types",
          "workshop_bays",
          "technicians",
          "technician_skills"
        ],
        "note": "A bay carries many bay types inline. A technician carries many skills."
      },
      {
        "id": "pricing",
        "label": "Pricing matrix",
        "focus": [
          "service_types",
          "service_type_costs",
          "vehicles"
        ],
        "note": "Cost is derived from service type and vehicle."
      },
      {
        "id": "delivery",
        "label": "Delivery",
        "focus": [
          "outbox_events"
        ],
        "note": "The outbox carries every notification. Transactional boundary protects delivery."
      }
    ]
