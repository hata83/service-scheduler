  "cards": [
    { "dot": "cyan", "title": "Component roles", "items": [
      "OTP Login turns a phone number into an httpOnly JWT cookie, keeping the service stateless",
      "REST API serves OpenAPI 3.1 contracts and rejects write requests without UUID v4 idempotency keys",
      "Constraint Evaluator checks relational metadata in pure Java: bay types, technician skills, and duration",
      "Booking Service allocates a bay and technicians, writing appointments and outbox events in one transaction",
      "Outbox Relay polls pending rows with SKIP LOCKED so multiple pods never race"
    ]},
    { "dot": "rose", "title": "Security boundary", "items": [
      "JWT is HMAC-SHA256 signed and stored in an httpOnly cookie, preventing script access",
      "SSE authenticates directly using the httpOnly JWT cookie with single-stream per phone enforcement",
      "Outbound webhooks carry HMAC-SHA256 signatures (X-Scheduler-Signature) for payload verification",
      "Resilience4j with Redis counters enforces sliding-window rate limits per IP and user"
    ]},
    { "dot": "emerald", "title": "Observability strategy", "items": [
      "Metrics: booking latency, slot utilization, conflict counts, evaluator duration, active SSE streams",
      "Logging: Logstash JSON with traceId, spanId, appointmentId, and dealershipId in MDC",
      "Tracing: MDC span context propagates across API requests, constraint evaluation, and relays",
      "Monitoring: actuator health probes monitor PostgreSQL and Redis availability"
    ]}
  ]
