    { "dot": "violet", "title": "Pure Java rule evaluation", "items": [
      "ServiceConstraintEvaluator evaluates constraints in pure Java with sub-millisecond latency",
      "Resource rules are stored in service_types and service_type_technician_requirements",
      "Zero external native binary (UniFFI) dependencies"
    ]},
    { "dot": "cyan", "title": "Dual resource gating", "items": [
      "The evaluator returns allowed bay types and required technician role slots",
