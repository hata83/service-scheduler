{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Slot Availability Check — Dual Resource Gate",
    "output": "availability-check.html",
    "column_fit": "spread",
    "animation": "trace",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "client",
      "type": "external",
      "label": "Client",
      "sublabel": "portal"
    },
    {
      "id": "api",
      "type": "backend",
      "label": "Slot API",
      "sublabel": "SlotAvailabilityService"
    },
    {
      "id": "auth",
      "type": "security",
      "label": "Auth",
      "sublabel": "JWT cookie"
    },
    {
      "id": "redis",
      "type": "database",
      "label": "Redis",
      "sublabel": "slot:grid cache"
    },
    {
      "id": "compute",
      "type": "backend",
      "label": "Grid Compute",
      "sublabel": "SlotGridComputeService"
    },
    {
      "id": "pg",
      "type": "database",
      "label": "PostgreSQL",
      "sublabel": "bays + assignments"
    }
  ],
  "segments": [
    {
      "from": 110,
      "to": 280,
      "label": "Auth and cache check"
    },
    {
      "from": 300,
      "to": 500,
      "label": "Dual-resource gate (on miss)"
    },
    {
      "from": 520,
      "to": 660,
      "label": "Cache write and response"
    }
  ],
  "messages": [
    {
      "id": "req",
      "from": "client",
      "to": "api",
      "y": 130,
      "label": "GET /api/v1/slots/available\n?dealershipId=&serviceTypeId=&date=",
      "variant": "emphasis"
    },
    {
      "id": "verify",
      "from": "api",
      "to": "auth",
      "y": 170,
      "label": "validate JWT cookie",
      "variant": "security"
    },
    {
      "id": "auth-ok",
      "from": "auth",
      "to": "api",
      "y": 205,
      "label": "principal + role",
      "variant": "return"
    },
    {
      "id": "cache-read",
      "from": "api",
      "to": "redis",
      "y": 250,
      "label": "GET slot:grid:{dealershipId}:{serviceTypeId}:{date}",
      "variant": "default"
    },
    {
      "id": "cache-hit",
      "from": "redis",
      "to": "api",
      "y": 282,
      "label": "HIT → cached grid JSON",
      "variant": "return"
    },
    {
      "id": "cache-miss-note",
      "from": "redis",
      "to": "api",
      "y": 310,
      "label": "MISS → compute from DB",
      "variant": "dashed"
    },
    {
      "id": "load-config",
      "from": "api",
      "to": "compute",
      "y": 345,
      "label": "compute(dealershipConfig,\nserviceType, date, now)",
      "variant": "default"
    },
    {
      "id": "gen-grid",
      "from": "compute",
      "to": "compute",
      "y": 375,
      "label": "Step 1: generate candidate slots\nfrom open/close/lunch/interval",
      "variant": "self"
    },
    {
      "id": "bay-query",
      "from": "compute",
      "to": "pg",
      "y": 405,
      "label": "Step 2 (bay gate): for each candidate slot\nSELECT bays WHERE bayType=ANY(allowed_bay_types)\nAND no overlapping active service_jobs\nORDER BY last_used_at ASC (LRU)",
      "variant": "default"
    },
    {
      "id": "bay-result",
      "from": "pg",
      "to": "compute",
      "y": 440,
      "label": "free bay list (or empty → slot excluded)",
      "variant": "return"
    },
    {
      "id": "tech-query",
      "from": "compute",
      "to": "pg",
      "y": 465,
      "label": "Step 3 (tech gate): for each required role slot\nSELECT technicians WHERE skill≥minLevel\nAND is_available=true\nAND no overlapping job_technician_assignments",
      "variant": "default"
    },
    {
      "id": "tech-result",
      "from": "pg",
      "to": "compute",
      "y": 500,
      "label": "candidate tech IDs per role slot",
      "variant": "return"
    },
    {
      "id": "greedy",
      "from": "compute",
      "to": "compute",
      "y": 525,
      "label": "Step 4+5: scarcest-slot-first greedy match\nSort role slots by candidate count ASC\nAssign each a distinct technician\nExclude slot if any role slot unfillable",
      "variant": "self"
    },
    {
      "id": "compute-done",
      "from": "compute",
      "to": "api",
      "y": 555,
      "label": "List<SlotAvailabilityResponse>\navailable=true|false per window",
      "variant": "return"
    },
    {
      "id": "cache-write",
      "from": "api",
      "to": "redis",
      "y": 590,
      "label": "SET slot:grid:… TTL={slotCacheTtlSeconds}",
      "variant": "dashed"
    },
    {
      "id": "reply",
      "from": "api",
      "to": "client",
      "y": 640,
      "label": "200 OK  [{startTime, endTime, available}, …]",
      "variant": "return"
    }
  ],
  "activations": [
    {
      "participant": "client",
      "from": 120,
      "to": 650,
      "type": "external"
    },
    {
      "participant": "api",
      "from": 125,
      "to": 645,
      "type": "backend"
    },
    {
      "participant": "auth",
      "from": 162,
      "to": 215,
      "type": "security"
    },
    {
      "participant": "redis",
      "from": 242,
      "to": 320,
      "type": "database"
    },
    {
      "participant": "compute",
      "from": 338,
      "to": 560,
      "type": "backend"
    },
    {
      "participant": "pg",
      "from": 398,
      "to": 510,
      "type": "database"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Dual Resource Gate — Both Must Pass",
      "items": [
        "Bay gate: at least one active bay matching allowed_bay_types has no overlapping active service_job",
        "Technician gate: every required role slot in service_type_technician_requirements can be filled by a distinct, qualified, unassigned technician",
        "Slots failing either gate have available=false in the response"
      ]
    },
    {
      "dot": "cyan",
      "title": "Greedy Scarcest-Slot Matching",
      "items": [
        "Role slots are sorted by candidate count ascending — the rarest skill fills first",
        "Each technician fills at most one role slot per job window",
        "If any role slot has zero unassigned candidates the entire time window is excluded"
      ]
    },
    {
      "dot": "amber",
      "title": "Cache Strategy",
      "items": [
        "Key: slot:grid:{dealershipId}:{serviceTypeId}:{date} — per service type, per date",
        "TTL: dealership.slotCacheTtlSeconds (default 1 hour)",
        "Date-level eviction on: booking committed, cancelled, no-show, check-in slot adjustment",
        "Dealership-level eviction on: bay change, technician change, config update"
      ]
    },
    {
      "dot": "red",
      "title": "Validation Limits",
      "items": [
        "HTTP 400 when date > today + dealership.maxAdvanceBookingDays (default 7 days)",
        "Past dates return an empty slot list without querying the database",
        "Rate limited: 100 requests per 60 seconds per IP"
      ]
    }
  ]
}
