{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Slot Availability Check \u2014 Dual Resource Gate",
    "output": "availability-check.html",
    "column_fit": "spread",
    "animation": "trace",
    "quality_profile": "showcase",
    "viewBox": [
      1200,
      850
    ]
  },
  "participants": [
    {
      "id": "client",
      "type": "external",
      "label": "Client",
      "sublabel": "portal"
    },
    {
      "id": "api",
      "type": "backend",
      "label": "Slot API",
      "sublabel": "SlotAvailabilityService"
    },
    {
      "id": "auth",
      "type": "security",
      "label": "Auth",
      "sublabel": "JWT cookie"
    },
    {
      "id": "redis",
      "type": "database",
      "label": "Redis",
      "sublabel": "slot:grid cache"
    },
    {
      "id": "compute",
      "type": "backend",
      "label": "Grid Compute",
      "sublabel": "SlotGridComputeService"
    },
    {
      "id": "pg",
      "type": "database",
      "label": "PostgreSQL",
      "sublabel": "bays + assignments"
    }
  ],
  "segments": [
    {
      "from": 140,
      "to": 325,
      "label": "Auth and cache check"
    },
    {
      "from": 340,
      "to": 525,
      "label": "Dual-resource gate (on miss)"
    },
    {
      "from": 540,
      "to": 730,
      "label": "Cache write and response"
    }
  ],
  "messages": [
    {
      "id": "req",
      "from": "client",
      "to": "api",
      "y": 170,
      "label": "GET /slots/available",
      "variant": "emphasis"
    },
    {
      "id": "verify",
      "from": "api",
      "to": "auth",
      "y": 210,
      "label": "validate JWT cookie",
      "variant": "security"
    },
    {
      "id": "auth-ok",
      "from": "auth",
      "to": "api",
      "y": 250,
      "label": "principal + role",
      "variant": "return"
    },
    {
      "id": "cache-read",
      "from": "api",
      "to": "redis",
      "y": 290,
      "label": "GET slot:grid key",
      "variant": "default"
    },
    {
      "id": "cache-hit",
      "from": "redis",
      "to": "api",
      "y": 330,
      "label": "HIT \u2192 cached grid",
      "variant": "return"
    },
    {
      "id": "cache-miss-note",
      "from": "redis",
      "to": "api",
      "y": 370,
      "label": "MISS \u2192 compute from DB",
      "variant": "dashed"
    },
    {
      "id": "load-config",
      "from": "api",
      "to": "compute",
      "y": 410,
      "label": "compute(config, service, date)",
      "variant": "default"
    },
    {
      "id": "bay-query",
      "from": "compute",
      "to": "pg",
      "y": 450,
      "label": "Bay gate: free bays query",
      "variant": "default"
    },
    {
      "id": "bay-result",
      "from": "pg",
      "to": "compute",
      "y": 490,
      "label": "free bay list",
      "variant": "return"
    },
    {
      "id": "tech-query",
      "from": "compute",
      "to": "pg",
      "y": 530,
      "label": "Tech gate: technicians query",
      "variant": "default"
    },
    {
      "id": "tech-result",
      "from": "pg",
      "to": "compute",
      "y": 570,
      "label": "candidate tech IDs",
      "variant": "return"
    },
    {
      "id": "compute-done",
      "from": "compute",
      "to": "api",
      "y": 610,
      "label": "available=true|false",
      "variant": "return"
    },
    {
      "id": "cache-write",
      "from": "api",
      "to": "redis",
      "y": 650,
      "label": "SET grid TTL",
      "variant": "dashed"
    },
    {
      "id": "reply",
      "from": "api",
      "to": "client",
      "y": 690,
      "label": "200 OK slot windows",
      "variant": "return"
    }
  ],
  "activations": [
    {
      "participant": "client",
      "from": 120,
      "to": 650,
      "type": "external"
    },
    {
      "participant": "api",
      "from": 125,
      "to": 645,
      "type": "backend"
    },
    {
      "participant": "auth",
      "from": 162,
      "to": 215,
      "type": "security"
    },
    {
      "participant": "redis",
      "from": 242,
      "to": 320,
      "type": "database"
    },
    {
      "participant": "compute",
      "from": 338,
      "to": 560,
      "type": "backend"
    },
    {
      "participant": "pg",
      "from": 398,
      "to": 510,
      "type": "database"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Dual Resource Gate \u2014 Both Must Pass",
      "items": [
        "Bay gate: at least one active bay matching allowed_bay_types has no overlapping active service_job",
        "Technician gate: every required role slot in service_type_technician_requirements can be filled by a distinct, qualified, unassigned technician",
        "Slots failing either gate have available=false in the response"
      ]
    },
    {
      "dot": "cyan",
      "title": "Greedy Scarcest-Slot Matching",
      "items": [
        "Role slots are sorted by candidate count ascending \u2014 the rarest skill fills first",
        "Each technician fills at most one role slot per job window",
        "If any role slot has zero unassigned candidates the entire time window is excluded"
      ]
    },
    {
      "dot": "amber",
      "title": "Cache Strategy",
      "items": [
        "Key: slot:grid:{dealershipId}:{serviceTypeId}:{date} \u2014 per service type, per date",
        "TTL: dealership.slotCacheTtlSeconds (default 1 hour)",
        "Date-level eviction on: booking committed, cancelled, no-show, check-in slot adjustment",
        "Dealership-level eviction on: bay change, technician change, config update"
      ]
    },
    {
      "dot": "rose",
      "title": "Validation Limits",
      "items": [
        "HTTP 400 when date > today + dealership.maxAdvanceBookingDays (default 7 days)",
        "Past dates return an empty slot list without querying the database",
        "Rate limited: 100 requests per 60 seconds per IP"
      ]
    }
  ]
}